# ZeroWaste Production Environment Configuration Template
# (Do NOT paste your real credentials into this example file)

# MongoDB Atlas Connection URI (REQUIRED on Render)
# Format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/zerowaste?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/zerowaste?retryWrites=true&w=majority

# Port (Render automatically sets this to 10000)
PORT=10000

# JWT Secret Key for user session tokens (Render can generate this or use a secure random string)
JWT_SECRET=replace_with_a_secure_random_string_in_production

# Node environment mode
NODE_ENV=production

# Payment gateway provider: 'demo' | 'razorpay' | 'stripe' (defaults to 'demo')
PAYMENT_PROVIDER=demo

# Demo data seeding: set to 'true' if you want realistic demo accounts seeded
SEED_DEMO_DATA=false
